<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility (Android 11+). A launcher must be able to enumerate every
      installed app, not just the pre-installed ones. Declaring the MAIN/LAUNCHER
      intent here grants visibility of all launchable apps without the
      Play-restricted QUERY_ALL_PACKAGES permission. The two theme actions do the
      same for installed icon packs.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
    </queries>

    <!--
      No permissions are requested. Haptics go through the view's own feedback
      API, the wallpaper picker and the uninstall prompt are system dialogs, and
      app ranking is counted locally instead of read from UsageStatsManager.
    -->

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".PixelLauncherApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Pixel Launcher"
        android:largeHeap="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Wallpaper.NoTitleBar">

        <!--
          The platform's own wallpaper theme replaces a hand-written styles file:
          it already gives a transparent window over the wallpaper. Everything
          else about the look - colours, type, insets, system bars - is decided in
          Kotlin at runtime so it can change without an activity restart.
        -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MONKEY" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="android.max_aspect"
            android:value="10.0" />

    </application>

</manifest>
